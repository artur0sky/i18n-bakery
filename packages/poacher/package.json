{
    "name": "@i18n-bakery/poacher",
    "version": "1.0.9",
    "description": "The Forager. Ventures into the wild (legacy code) to recover valuable ingredients (keys) and bring them back to the safety of the bakery.",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "bin": {
        "poacher": "./bin/poacher.js"
    },
    "files": [
        "dist",
        "bin"
    ],
    "scripts": {
        "build": "tsup src/index.ts --format cjs,esm --dts",
        "dev": "tsup src/index.ts --format cjs,esm --watch --dts",
        "test": "vitest run"
    },
    "keywords": [
        "i18n",
        "migration",
        "converter",
        "i18next",
        "bakery",
        "poacher"
    ],
    "author": "Arturo Sáenz",
    "license": "MIT",
    "dependencies": {
        "@i18n-bakery/baker": "workspace:*",
        "@i18n-bakery/core": "workspace:*",
        "cac": "7.1.1",
        "chalk": "6.0.1",
        "fs-extra": "11.4.1"
    },
    "devDependencies": {
        "@types/fs-extra": "11.0.4",
        "@types/node": "24.19.4",
        "tsup": "9.0.0",
        "typescript": "6.0.3",
        "vitest": "5.1.2"
    }
}