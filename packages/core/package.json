{
  "name": "@i18n-bakery/core",
  "version": "1.0.10",
  "description": "The Head Chef. The mastermind managing logic, recipes (keys), and ensuring consistency across every dish. Framework-agnostic excellence.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run"
  },
  "keywords": [
    "i18n",
    "internationalization",
    "localization",
    "translation",
    "typescript",
    "type-safe",
    "bakery",
    "core"
  ],
  "author": "Arturo Sáenz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artur0sky/i18n-bakery.git"
  },
  "bugs": {
    "url": "https://github.com/artur0sky/i18n-bakery/issues"
  },
  "homepage": "https://github.com/artur0sky/i18n-bakery#readme",
  "packageManager": "pnpm@10.20.0",
  "devDependencies": {
    "@types/node": "24.19.4",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "vitest": "5.1.2"
  }
}