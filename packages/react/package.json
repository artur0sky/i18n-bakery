{
    "name": "@i18n-bakery/react",
    "version": "1.0.10",
    "description": "The React Waiter. Delivers freshly baked translations right to your React components' table. Impeccable service with hooks and context.",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "require": "./dist/index.js",
            "import": "./dist/index.mjs"
        }
    },
    "scripts": {
        "build": "tsup src/index.ts --format cjs,esm --dts",
        "dev": "tsup src/index.ts --format cjs,esm --watch --dts",
        "test": "vitest run --environment jsdom"
    },
    "keywords": [
        "i18n",
        "react",
        "hooks",
        "context",
        "localization",
        "translation",
        "bakery",
        "typescript"
    ],
    "author": "Arturo Sáenz",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/artur0sky/i18n-bakery.git"
    },
    "bugs": {
        "url": "https://github.com/artur0sky/i18n-bakery/issues"
    },
    "homepage": "https://github.com/artur0sky/i18n-bakery#readme",
    "peerDependencies": {
        "@i18n-bakery/core": "workspace:*",
        "react": ">=16.8.0"
    },
    "dependencies": {
        "@i18n-bakery/core": "workspace:*"
    },
    "devDependencies": {
        "@testing-library/react": "16.3.3",
        "@types/react": "19.3.3",
        "jsdom": "31.0.1",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "tsup": "9.0.0",
        "typescript": "6.0.3",
        "vitest": "5.1.2"
    }
}